# Dependencias, compilacion y archivos temporales
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
node_modules/
dist/
build/
*.log
*.tmp
*.sqlite*
*.db
.coverage
htmlcov/
coverage/

# Configuracion privada y herramientas locales
.env
.env.*
!.env.example
.vscode/
.idea/
.DS_Store
Thumbs.db
/backend/.cache/
/backend/tmp/

# Datos locales: se versiona solamente la estructura vacia
/HistoricosEnUso/*
!/HistoricosEnUso/.gitkeep
/data/*
!/data/cache/
!/data/static_history/
!/data/fixtures/
!/data/review/
/data/cache/*
!/data/cache/.gitkeep
/data/static_history/*
!/data/static_history/.gitkeep
/data/fixtures/*
!/data/fixtures/.gitkeep
/data/review/*
!/data/review/.gitkeep

# Material de investigacion, respaldos y recursos no usados
/docs/
/local/
/outputs/
/tmp/

# Snapshot reutilizable GAT-LSTM: artefactos publicados mediante Git LFS.
/artifacts/gat_lstm/*
!/artifacts/gat_lstm/manifest.json
!/artifacts/gat_lstm/README.md
!/artifacts/gat_lstm/*.tar.gz
